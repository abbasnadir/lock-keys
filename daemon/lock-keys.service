[Unit]
Description=A daemon that gives live update about capslock and numslock keys and exposes their states to frontend.
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/lock-keys-daemon

Restart=always
RestartSec=0.5

# Needs root for /dev/input
User=root
Group=root

# Dev-friendly env
Environment=RUST_LOG=debug
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
