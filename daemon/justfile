name := 'lock-keys-daemon'

rootdir := ''
prefix := '/usr'

# Installation paths
base-dir := absolute_path(clean(rootdir / prefix))
# The daemon is part of the lock-keys workspace, which builds into ../target.
cargo-target-dir := env('CARGO_TARGET_DIR', '..' / 'target')
bin-dst := base-dir / 'bin' / name
# lock-keys.service runs /usr/bin/lock-keys-daemon; change ExecStart if prefix differs.
service-dst := base-dir / 'lib' / 'systemd' / 'system' / 'lock-keys.service'

# Default recipe which runs `just build-release`
default: build-release

# Compiles with debug profile
build-debug *args:
    cargo build {{args}}

# Compiles with release profile
build-release *args: (build-debug '--release' args)

# Runs a clippy check
check *args:
    cargo clippy --all-features {{args}} -- -W clippy::pedantic

# Installs files
install:
    install -Dm0755 {{ cargo-target-dir / 'release' / name }} {{bin-dst}}
    install -Dm0644 lock-keys.service {{service-dst}}

# Uninstalls installed files
uninstall:
    rm {{bin-dst}} {{service-dst}}
